# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=your-app-key-here
# Publiczny adres aplikacji — używany w linkach w mailach (w produkcji WYMAGANY).
# Produkcja: APP_URL=https://app.canvai.dev
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
# Options: sqlite, pg, mysql, mssql
DB_CONNECTION=sqlite

# PostgreSQL (set DB_CONNECTION=pg to use)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=design_canvas
# AI (M3: analiza assetow -> DESIGN.md)
# Dostawca modelu: mock (bez sieci, domyslny) albo deepseek (api.deepseek.com).
AI_PROVIDER=mock

# Klucz API DeepSeek. Wygeneruj na https://platform.deepseek.com/api_keys
# i wklej TUTAJ, w pliku .env (nie w .env.example - ten plik jest w repo).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
# Tryb rozumowania modelu: off (domyślnie, szybciej) | low | high
DEEPSEEK_THINKING=off

# Kolejka generacji: worker w procesie `node ace serve` (domyslnie true).
# Przy wielu instancjach ustaw false i uruchom osobno `node ace queue:work`.
QUEUE_INLINE_WORKER=true

# Poczta (weryfikacja e-mail, reset hasła).
# outbox = maile zapisywane lokalnie w tmp/mail-outbox + podgląd /dev/mailbox (domyślnie)
# smtp   = prawdziwa wysyłka przez serwer SMTP
MAIL_MAILER=outbox
MAIL_FROM_NAME=canvai
MAIL_FROM_ADDRESS=no-reply@canvai.dev
SMTP_HOST=smtp.twojadomena.pl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Microsoft Clarity (analityka po zgodzie użytkownika); puste = wyłączone.
CLARITY_PROJECT_ID=

# Rozliczenia — kredyty i plany (config/billing.ts). false = bez limitów (self-hosting).
BILLING_ENFORCED=true
# Polar.sh (Merchant of Record): Settings → Developers → Organization Access Token
# (zakresy: checkouts:write, customer_sessions:write). Webhook: Settings → Webhooks →
# URL https://app.canvai.dev/webhooks/polar, format Raw, sekret do POLAR_WEBHOOK_SECRET.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# sandbox = sandbox.polar.sh (testowe płatności), production = polar.sh
POLAR_SERVER=production
# ID produktów (Products → produkt → ID): pakiety 100/300/1000 i subskrypcja Pro (miesięczna).
POLAR_PRODUCT_PACK_S=
POLAR_PRODUCT_PACK_M=
POLAR_PRODUCT_PACK_L=
POLAR_PRODUCT_PRO=

# Analityka i logi (ClickHouse) — puste CLICKHOUSE_URL = zbieranie wyłączone.
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=canvai
# Panel CRM: host (dev: crm.localhost) i adresy administratorów (po przecinku).
CRM_HOST=
ADMIN_EMAILS=
