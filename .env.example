# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=your-app-key-here
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
# Options: sqlite, pg, mysql, mssql
DB_CONNECTION=sqlite

# PostgreSQL (set DB_CONNECTION=pg to use)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=design_canvas