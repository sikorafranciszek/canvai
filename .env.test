# Osobny port serwera testowego — nie koliduje z innymi usługami na 3333.
PORT=3901
SESSION_DRIVER=memory
AI_PROVIDER=mock
QUEUE_INLINE_WORKER=false
BILLING_ENFORCED=false
# Testy na osobnej bazie PostgreSQL (host/port/użytkownik/hasło z .env lub zmiennych środowiska).
DB_CONNECTION=pg
DB_DATABASE=canvai_test
