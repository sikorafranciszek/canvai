<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{{ subject }}</title>
  </head>
  <body style="margin:0;padding:0;background:#faf8f5;font-family:Inter,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#27251e;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#faf8f5;padding:40px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;">
            <tr>
              <td style="padding:0 4px 20px;font-size:15px;font-weight:500;color:#27251e;">
                <span style="display:inline-block;width:22px;height:22px;border-radius:6px;background:#27251e;vertical-align:middle;margin-right:8px;"></span>
                <span style="vertical-align:middle;">canvai</span>
              </td>
            </tr>
            <tr>
              <td style="background:#fdfbfa;border-radius:16px;box-shadow:0 1px 2px rgba(0,0,0,0.08);padding:32px;">
                <h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;font-weight:500;color:#27251e;">{{ heading }}</h1>
                <p style="margin:0 0 12px;font-size:14px;line-height:1.6;color:#27251e;">{{ greeting }}</p>
                <p style="margin:0 0 24px;font-size:14px;line-height:1.6;color:#27251e;">{{ intro }}</p>
                <table role="presentation" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="border-radius:12px;background:#27251e;">
                      <a href="{{ url }}" style="display:inline-block;padding:12px 20px;font-size:14px;font-weight:500;color:#faf8f5;text-decoration:none;border-radius:12px;">{{ button }}</a>
                    </td>
                  </tr>
                </table>
                @if(expires)
                  <p style="margin:20px 0 0;font-size:12px;line-height:1.5;color:#72706b;">{{ expires }}</p>
                @end
                <p style="margin:20px 0 6px;font-size:12px;line-height:1.5;color:#72706b;">{{ linkFallback }}</p>
                <p style="margin:0;font-size:12px;line-height:1.5;word-break:break-all;"><a href="{{ url }}" style="color:#016a71;">{{ url }}</a></p>
                <hr style="border:0;border-top:1px solid #e6e3dd;margin:24px 0 16px;" />
                <p style="margin:0;font-size:12px;line-height:1.5;color:#92918b;">{{ ignore }}</p>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 4px 0;font-size:11px;line-height:1.5;color:#92918b;">{{ footer }}</td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
