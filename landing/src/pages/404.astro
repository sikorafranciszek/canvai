---
import Base from '../layouts/Base.astro'
import Lost from '../components/illos/Lost.astro'
import { content } from '../i18n/content'
const t = content.en
const pl = content.pl
---

<Base t={t} title="404 — canvai" noindex>
  <section class="nf">
    <div class="container nf__inner">
      <Lost />
      <div class="nf__code">404</div>
      <h1 class="h2">{t.notFound.title}</h1>
      <p class="muted">{t.notFound.text}</p>
      <p class="muted" lang="pl">{pl.notFound.title} — {pl.notFound.text}</p>
      <div style="display:flex;gap:10px;margin-top:8px">
        <a class="btn btn--primary" href="/">{t.notFound.back}</a>
        <a class="btn" href="/pl/" lang="pl">{pl.notFound.back}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding: 72px 0 120px;
  }
  .nf__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }
  .nf__code {
    font-size: 88px;
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--warm-mist);
  }
</style>
