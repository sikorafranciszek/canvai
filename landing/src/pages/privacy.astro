---
import Base from '../layouts/Base.astro'
import PrivacyPage from '../components/PrivacyPage.astro'
import { content } from '../i18n/content'
import { PRIVACY_PATH, privacy } from '../i18n/privacy'
const t = content.en
---

<Base t={t} title={`${privacy.en.title} — canvai`} description={privacy.en.metaDescription} langPaths={PRIVACY_PATH}>
  <PrivacyPage lang="en" />
</Base>
