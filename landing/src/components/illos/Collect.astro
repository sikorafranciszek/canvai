---
/** Krok 1 — „Zbierz”: materiały wpadają na kanwę po Ctrl+V. */
---

<svg class="illo" data-anim viewBox="0 0 320 180" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="collect-dots" width="12" height="12" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1" fill="#27251e" opacity="0.13"></circle>
    </pattern>
  </defs>
  <rect x="0.5" y="0.5" width="319" height="179" rx="14" fill="#f4f1ec" stroke="#e6e3dd"></rect>
  <rect x="1" y="1" width="318" height="178" rx="14" fill="url(#collect-dots)"></rect>

  <!-- zrzut ekranu -->
  <g class="a drop" style="--k:0">
    <rect x="30" y="46" width="96" height="84" rx="10" fill="#fdfbfa" stroke="#e6e3dd"></rect>
    <rect x="38" y="54" width="80" height="50" rx="6" fill="#e8d3b7"></rect>
    <circle cx="104" cy="67" r="6" fill="#c8702a"></circle>
    <path d="M38 104 L60 82 L75 95 L88 85 L118 104 Z" fill="#b98b61"></path>
    <rect x="38" y="112" width="48" height="6" rx="3" fill="#d1d1cd"></rect>
    <rect x="38" y="121" width="30" height="4" rx="2" fill="#e6e3dd"></rect>
  </g>

  <!-- paleta -->
  <g class="a drop" style="--k:1">
    <rect x="140" y="34" width="76" height="70" rx="10" fill="#fdfbfa" stroke="#e6e3dd"></rect>
    <circle class="a pop" style="--p:0" cx="160" cy="58" r="11" fill="#016a71"></circle>
    <circle class="a pop" style="--p:1" cx="186" cy="58" r="11" fill="#c8702a"></circle>
    <circle class="a pop" style="--p:2" cx="160" cy="84" r="7" fill="#27251e"></circle>
    <rect x="173" y="80" width="30" height="8" rx="4" fill="#d1d1cd"></rect>
  </g>

  <!-- notatka -->
  <g class="a drop" style="--k:2">
    <rect x="228" y="58" width="68" height="68" rx="6" fill="#fdf3c9" stroke="#f0e2a6"></rect>
    <rect x="238" y="72" width="46" height="5" rx="2.5" fill="#27251e" opacity="0.18"></rect>
    <rect x="238" y="83" width="36" height="5" rx="2.5" fill="#27251e" opacity="0.18"></rect>
    <rect x="238" y="94" width="42" height="5" rx="2.5" fill="#27251e" opacity="0.18"></rect>
  </g>

  <!-- kursor + skrót -->
  <g class="a cursor">
    <path
      d="M200 128 L200 152 L206 146 L210 156 L214 154 L210 144 L218 144 Z"
      fill="#27251e"
      stroke="#fdfbfa"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
    <g class="a key">
      <rect x="222" y="140" width="46" height="22" rx="6" fill="#27251e"></rect>
      <text
        x="245"
        y="155"
        text-anchor="middle"
        font-family="Inter Variable, Inter, system-ui, sans-serif"
        font-size="10.5"
        font-weight="600"
        fill="#faf8f5">Ctrl V</text>
    </g>
  </g>
</svg>

<style>
  .drop {
    animation: collect-drop 6s cubic-bezier(0.34, 1.56, 0.64, 1) infinite both;
    animation-delay: calc(var(--k) * 0.35s);
  }
  @keyframes collect-drop {
    0% {
      opacity: 0;
      transform: translateY(-28px) rotate(-4deg) scale(0.94);
    }
    9% {
      opacity: 1;
      transform: translateY(2px) scale(1.03, 0.96);
    }
    14% {
      transform: translateY(-2px) scale(0.99, 1.01);
    }
    18%,
    82% {
      opacity: 1;
      transform: none;
    }
    92%,
    100% {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }
  .pop {
    animation: collect-pop 6s cubic-bezier(0.34, 1.56, 0.64, 1) infinite both;
    animation-delay: calc(0.6s + var(--p) * 0.12s);
  }
  @keyframes collect-pop {
    0% {
      transform: scale(0);
    }
    8%,
    100% {
      transform: scale(1);
    }
  }
  .cursor {
    animation: collect-cursor 6s ease-in-out infinite;
  }
  @keyframes collect-cursor {
    0%,
    100% {
      transform: translate(0, 0);
    }
    30%,
    70% {
      transform: translate(-14px, -6px);
    }
  }
  .key {
    transform-origin: 50% 100%;
    animation: collect-key 6s ease-out infinite;
  }
  @keyframes collect-key {
    0%,
    100% {
      transform: none;
    }
    2%,
    8%,
    14% {
      transform: scale(0.9);
    }
    5%,
    11%,
    17% {
      transform: none;
    }
  }
</style>
