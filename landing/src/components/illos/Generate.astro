---
/** Krok 3 — „Generuj”: DESIGN.md pisze się linia po linii, tokeny wskakują, iskry migoczą. */
---

<svg class="illo" data-anim viewBox="0 0 320 180" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="generate-dots" width="12" height="12" patternUnits="userSpaceOnUse">
      <circle cx="1.5" cy="1.5" r="1" fill="#27251e" opacity="0.13"></circle>
    </pattern>
  </defs>
  <rect x="0.5" y="0.5" width="319" height="179" rx="14" fill="#f4f1ec" stroke="#e6e3dd"></rect>
  <rect x="1" y="1" width="318" height="178" rx="14" fill="url(#generate-dots)"></rect>

  <!-- dokument -->
  <g class="a doc">
    <rect x="92" y="20" width="136" height="144" rx="10" fill="#fdfbfa" stroke="#e6e3dd"></rect>
    <rect x="92.5" y="20.5" width="135" height="22" rx="10" fill="#27251e"></rect>
    <rect x="92.5" y="32" width="135" height="10.5" fill="#27251e"></rect>
    <rect x="102" y="28" width="8" height="8" rx="2" fill="#7fd1d6"></rect>
    <rect x="116" y="30" width="44" height="4" rx="2" fill="#faf8f5" opacity="0.8"></rect>
  </g>

  <!-- linie tekstu -->
  <rect class="a line" style="--n:0" x="104" y="54" width="72" height="7" rx="3.5" fill="#27251e"></rect>
  <rect class="a line" style="--n:1" x="104" y="68" width="108" height="5" rx="2.5" fill="#d1d1cd"></rect>
  <rect class="a line" style="--n:2" x="104" y="78" width="90" height="5" rx="2.5" fill="#d1d1cd"></rect>

  <!-- tokeny kolorów -->
  <circle class="a tok" style="--n:0" cx="112" cy="100" r="8" fill="#016a71"></circle>
  <circle class="a tok" style="--n:1" cx="132" cy="100" r="8" fill="#c8702a"></circle>
  <circle class="a tok" style="--n:2" cx="152" cy="100" r="8" fill="#e8d3b7"></circle>
  <circle class="a tok" style="--n:3" cx="172" cy="100" r="8" fill="#27251e"></circle>

  <rect class="a line" style="--n:3" x="104" y="118" width="60" height="7" rx="3.5" fill="#27251e"></rect>
  <rect class="a line" style="--n:4" x="104" y="132" width="100" height="5" rx="2.5" fill="#d1d1cd"></rect>
  <rect class="a line" style="--n:5" x="104" y="142" width="80" height="5" rx="2.5" fill="#d1d1cd"></rect>

  <!-- odznaka „gotowe” -->
  <g class="a badge">
    <circle cx="226" cy="24" r="13" fill="#016a71"></circle>
    <path
      d="M220 24 L224.5 28.5 L232 20.5"
      fill="none"
      stroke="#fdfbfa"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </g>

  <!-- iskry -->
  <path
    class="a spark"
    style="--s:0"
    d="M56 58 Q58 68 68 70 Q58 72 56 82 Q54 72 44 70 Q54 68 56 58 Z"
    fill="#016a71"></path>
  <path
    class="a spark"
    style="--s:1"
    d="M266 104 Q267.5 111 274 112 Q267.5 113 266 120 Q264.5 113 258 112 Q264.5 111 266 104 Z"
    fill="#c8702a"></path>
  <path
    class="a spark"
    style="--s:2"
    d="M62 124 Q63 129 68 130 Q63 131 62 136 Q61 131 56 130 Q61 129 62 124 Z"
    fill="#27251e"></path>
  <path
    class="a spark"
    style="--s:3"
    d="M258 48 Q259 53 264 54 Q259 55 258 60 Q257 55 252 54 Q257 53 258 48 Z"
    fill="#016a71"></path>
</svg>

<style>
  .doc {
    animation: generate-doc 6s cubic-bezier(0.34, 1.4, 0.64, 1) infinite both;
  }
  @keyframes generate-doc {
    0% {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
    8%,
    88% {
      opacity: 1;
      transform: none;
    }
    98%,
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .line {
    transform-origin: 0% 50%;
    animation: generate-line 6s cubic-bezier(0.22, 1, 0.36, 1) infinite both;
    animation-delay: calc(0.45s + var(--n) * 0.28s);
  }
  @keyframes generate-line {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    7%,
    70% {
      transform: scaleX(1);
      opacity: 1;
    }
    80%,
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  .tok {
    animation: generate-tok 6s cubic-bezier(0.34, 1.8, 0.64, 1) infinite both;
    animation-delay: calc(1.1s + var(--n) * 0.12s);
  }
  @keyframes generate-tok {
    0% {
      transform: scale(0);
    }
    6%,
    66% {
      transform: scale(1);
    }
    74%,
    100% {
      transform: scale(0);
    }
  }
  .badge {
    animation: generate-badge 6s cubic-bezier(0.34, 1.8, 0.64, 1) infinite both;
  }
  @keyframes generate-badge {
    0%,
    52% {
      transform: scale(0) rotate(-40deg);
    }
    60%,
    86% {
      transform: none;
    }
    94%,
    100% {
      transform: scale(0);
    }
  }
  .spark {
    animation: generate-spark 2.4s ease-in-out infinite both;
    animation-delay: calc(var(--s) * -0.6s);
  }
  @keyframes generate-spark {
    0%,
    100% {
      transform: scale(0.5) rotate(0deg);
      opacity: 0.35;
    }
    50% {
      transform: scale(1.1) rotate(45deg);
      opacity: 1;
    }
  }
</style>
