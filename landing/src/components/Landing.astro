---
import type { Content } from '../i18n/content'
import { appLink } from '../i18n/content'
import Icon from './Icon.astro'
import Collect from './illos/Collect.astro'
import Arrange from './illos/Arrange.astro'
import Generate from './illos/Generate.astro'
import Pipeline from './illos/Pipeline.astro'
import type { IconName } from './icons'

interface Props {
  t: Content
}
const { t } = Astro.props
const signup = appLink('/signup', t.lang)
const login = appLink('/login', t.lang)

const problemIcons: IconName[] = ['shuffle', 'puzzle', 'timer']
const stepArt = [Collect, Arrange, Generate]
const audienceIcons: IconName[] = ['briefcase', 'users', 'rocket']

/** Fragment prawdziwego formatu dokumentu (angielski — dokument jest dla AI). */
const docExcerpt = `# Kawiarnia Ziarno — Style Reference
> warm paper canvas, espresso type, one terracotta accent

**Theme:** light

## Tokens — Colors
| Name       | Value     | Token            | Source |
|------------|-----------|------------------|--------|
| Parchment  | \`#faf5ec\` | \`--color-canvas\` | [A12]  |
| Espresso   | \`#3a2a1f\` | \`--color-ink\`    | [A12]  |
| Terracotta | \`#c8702a\` | \`--color-accent\` | [A14]  |

## Components
### Primary Button
**Role:** High-emphasis action
Terracotta (#c8702a) fill, 8px radius, 10px / 16px padding…

## Quick Start
:root {
  --color-canvas: #faf5ec;
  --color-accent: #c8702a;
  --radius-buttons: 8px;
}`
const docLines = docExcerpt.split('\n')
---

<!-- HERO -->
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="eyebrow eyebrow--live" data-enter style="--d:0">{t.hero.eyebrow}</span>
      <h1 class="h1" data-enter style="--d:1">{t.hero.title}</h1>
      <p class="lead" data-enter style="--d:2">{t.hero.subtitle}</p>
      <div class="hero__ctas" data-enter style="--d:3">
        <a class="btn btn--primary btn--lg" href={signup}>
          {t.hero.primary}
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--lg" href={login}>{t.hero.secondary}</a>
      </div>
      <p class="hero__note" data-enter style="--d:4">{t.hero.note}</p>
    </div>
    <div class="hero__visual" data-enter style="--d:4">
      <div class="stage" data-tilt>
        <!-- Materiały „przyklejone” do kanwy — neutralne językowo, czysto dekoracyjne. -->
        <div class="chip chip--swatch" aria-hidden="true" style="--x:-4%;--y:14%;--r:-5deg;--f:0">
          <span class="chip__dot" style="background:#016a71"></span>
          <span class="chip__mono">#016A71</span>
        </div>
        <div class="chip chip--type" aria-hidden="true" style="--x:99%;--y:34%;--r:4deg;--f:1">
          <span class="chip__aa">Aa</span>
          <span class="chip__meta">Inter<br /><span>400 · 500</span></span>
        </div>
        <div class="chip chip--note" aria-hidden="true" style="--x:-3%;--y:70%;--r:3deg;--f:2">
          <span class="chip__line" style="width:82%"></span>
          <span class="chip__line" style="width:64%"></span>
          <span class="chip__line" style="width:74%"></span>
        </div>
        <div class="chip chip--ref" aria-hidden="true" style="--x:98%;--y:80%;--r:-3deg;--f:3">
          <span class="chip__tag">[A12]</span>
          <span class="chip__mono">--radius: 8px</span>
        </div>
      <div class="window">
        <div class="window__bar" aria-hidden="true">
          <span></span><span></span><span></span>
          <div class="window__url">app.canvai.dev</div>
        </div>
        <picture>
          <source srcset={`/screens/hero-${t.lang}.webp`} type="image/webp" />
          <img
            src={`/screens/hero-${t.lang}.png`}
            alt={t.hero.imageAlt}
            width="1440"
            height="900"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>
      </div>
    </div>
  </div>
</section>

<!-- PROBLEM -->
<section class="section section--tint" id="problem">
  <div class="container">
    <div class="section__head" data-reveal>
      <span class="eyebrow">{t.problem.eyebrow}</span>
      <h2 class="h2">{t.problem.title}</h2>
    </div>
    <div class="grid-3">
      {
        t.problem.items.map((item, i) => (
          <div class="card card--outlined feature lift" data-reveal style={`--i:${i}`}>
            <div class="icon-tile">
              <Icon name={problemIcons[i]} />
            </div>
            <h3 class="h3">{item.title}</h3>
            <p class="muted">{item.text}</p>
          </div>
        ))
      }
    </div>
    <p class="solution" data-reveal>
      <Icon name="check" size={18} />
      {t.problem.solution}
    </p>
  </div>
</section>

<!-- HOW -->
<section class="section" id="how">
  <div class="container">
    <div class="section__head section__head--center" data-reveal>
      <span class="eyebrow">{t.how.eyebrow}</span>
      <h2 class="h2">{t.how.title}</h2>
    </div>
    <ol class="steps">
      {
        t.how.steps.map((step, i) => {
          const Art = stepArt[i]
          return (
          <li class="step lift" data-reveal style={`--i:${i}`}>
            <div class="step__art">
              <Art />
            </div>
            <h3 class="h3 step__title">
              <span class="step__num">{i + 1}</span>
              {step.title}
            </h3>
            <p class="muted">{step.text}</p>
          </li>
          )
        })
      }
    </ol>
  </div>
</section>

<!-- FEATURES -->
<section class="section section--tint" id="features">
  <div class="container">
    <div class="section__head" data-reveal>
      <span class="eyebrow">{t.features.eyebrow}</span>
      <h2 class="h2">{t.features.title}</h2>
    </div>
    <div class="grid-4">
      {
        t.features.items.map((f, i) => (
          <div class="card feature lift" data-reveal style={`--i:${i % 4}`}>
            <div class="icon-tile">
              <Icon name={f.icon as IconName} />
            </div>
            <h3 class="h3">{f.title}</h3>
            <p class="muted small">{f.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- DESIGN.md -->
<section class="section" id="design-md">
  <div class="container doc">
    <div class="doc__copy" data-reveal>
      <span class="eyebrow">{t.doc.eyebrow}</span>
      <h2 class="h2">{t.doc.title}</h2>
      <p class="lead">{t.doc.text}</p>
      <ul class="checklist">
        {
          t.doc.points.map((p, i) => (
            <li style={`--i:${i}`}>
              <span class="checklist__icon">
                <Icon name="check" size={14} strokeWidth={2.25} />
              </span>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="doc__code">
      <div class="code" data-reveal="scale">
        <div class="code__bar">
          <Icon name="fileText" size={15} />
          DESIGN.md
        </div>
        <pre><code>{docLines.map((line, i) => <span class="ln" style={`--l:${i}`}>{line + '\n'}</span>)}<span class="caret" aria-hidden="true" /></code></pre>
      </div>
    </div>
  </div>
</section>

<!-- AUDIENCE -->
<section class="section section--tint" id="audience">
  <div class="container">
    <div class="section__head" data-reveal>
      <span class="eyebrow">{t.audience.eyebrow}</span>
      <h2 class="h2">{t.audience.title}</h2>
    </div>
    <div class="grid-3">
      {
        t.audience.items.map((a, i) => (
          <div class="card feature lift" data-reveal style={`--i:${i}`}>
            <div class="icon-tile">
              <Icon name={audienceIcons[i]} />
            </div>
            <h3 class="h3">{a.title}</h3>
            <p class="muted">{a.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- PRICING -->
<section class="section" id="pricing">
  <div class="container">
    <div class="section__head section__head--center" data-reveal>
      <span class="eyebrow">{t.pricing.eyebrow}</span>
      <h2 class="h2">{t.pricing.title}</h2>
      <p class="lead">{t.pricing.subtitle}</p>
    </div>
    <div class="plans">
      {
        t.pricing.plans.map((plan, i) => (
          <article
            data-reveal
            style={`--i:${i}`}
            class:list={['plan', { 'plan--highlighted': plan.highlighted, 'plan--soon': plan.status === 'soon' }]}
            data-plan={plan.id}
          >
            <div class="plan__head">
              <h3 class="plan__name">{plan.name}</h3>
              <span class:list={['badge', plan.status === 'available' ? 'badge--accent' : 'badge--muted']}>
                {plan.badge ?? (plan.status === 'available' ? t.pricing.availableBadge : t.pricing.soonBadge)}
              </span>
            </div>
            <div class="plan__price">
              <span class="plan__amount">{plan.price}</span>
              <span class="plan__note">{plan.priceNote}</span>
            </div>
            <p class="muted small">{plan.description}</p>
            {plan.features.length ? (
              <ul class="checklist checklist--small">
                {plan.features.map((f) => (
                  <li>
                    <span class="checklist__icon">
                      <Icon name="check" size={13} strokeWidth={2.25} />
                    </span>
                    {f}
                  </li>
                ))}
              </ul>
            ) : (
              <div class="plan__placeholder" aria-hidden="true">
                <span />
                <span />
                <span />
              </div>
            )}
            {plan.status === 'available' ? (
              <a class="btn btn--primary plan__cta" href={signup}>
                {plan.cta}
              </a>
            ) : (
              <span class="btn plan__cta plan__cta--disabled" aria-disabled="true">
                {plan.cta}
              </span>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="section section--tint" id="faq">
  <div class="container faq">
    <div class="section__head" data-reveal>
      <span class="eyebrow">{t.faq.eyebrow}</span>
      <h2 class="h2">{t.faq.title}</h2>
    </div>
    <div class="faq__list" data-reveal>
      {
        t.faq.items.map((item, i) => (
          <details class="faq__item" open={i === 0}>
            <summary>
              {item.q}
              <span class="faq__plus" aria-hidden="true" />
            </summary>
            <p class="muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section cta-section">
  <div class="container">
    <div class="cta" data-reveal="scale">
      <Pipeline />
      <h2 class="h2">{t.cta.title}</h2>
      <p class="lead">{t.cta.text}</p>
      <div class="hero__ctas" style="justify-content:center">
        <a class="btn btn--accent btn--lg" href={signup}>
          {t.cta.primary}
          <Icon name="arrowRight" />
        </a>
        <a class="btn btn--ghost-light btn--lg" href={login}>{t.cta.secondary}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* HERO */
  .hero {
    /* Chipy i pochylenie 3D nie mogą poszerzać strony (clip nie psuje sticky). */
    overflow-x: clip;
    padding: clamp(48px, 7vw, 88px) 0 clamp(56px, 8vw, 96px);
    background-image: radial-gradient(rgba(39, 37, 30, 0.12) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -11px -11px;
    border-bottom: 1px solid var(--hairline);
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 6vw, 64px);
  }
  .hero__copy {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  .hero__note {
    font-size: 13px;
    color: var(--ash);
  }
  .window {
    border-radius: var(--r-2xl);
    overflow: hidden;
    background: var(--soft-paper);
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-float);
  }
  .window__bar {
    height: 38px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 14px;
    border-bottom: 1px solid var(--hairline);
    background: var(--sidebar);
  }
  .window__bar > span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--warm-mist);
  }
  .window__url {
    margin: 0 auto;
    padding: 3px 14px;
    border-radius: 999px;
    background: var(--soft-paper);
    border: 1px solid var(--hairline);
    font-size: 12px;
    color: var(--graphite);
    transform: translateX(-20px);
  }
  .window img {
    width: 100%;
    height: auto;
  }

  /* PROBLEM / FEATURES */
  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .small {
    font-size: 15px;
  }
  .solution {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 500;
  }
  .solution :global(svg) {
    color: var(--teal);
    flex-shrink: 0;
  }

  /* HOW */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    counter-reset: step;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border-radius: var(--r-xl);
    border: 1px solid var(--hairline);
    background: var(--soft-paper);
  }
  .step__art {
    margin: -8px -8px 6px;
  }
  .step__title {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .step__num {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 600;
    background: var(--hover);
    color: var(--graphite);
  }
  @media (max-width: 720px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  /* DESIGN.md */
  .doc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .doc__copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 6px;
  }
  .checklist li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .checklist__icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--teal-tint);
    color: var(--teal);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .checklist--small {
    font-size: 14px;
    gap: 8px;
  }
  .code {
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--ink);
    color: #e9e5dc;
    box-shadow: var(--shadow-float);
  }
  .code__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    font-size: 13px;
    color: #b8b3a8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .code pre {
    margin: 0;
    padding: 18px 20px 22px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.65;
  }
  @media (max-width: 900px) {
    .doc {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* PRICING */
  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    border-radius: var(--r-2xl);
    background: var(--soft-paper);
    border: 1px solid var(--hairline);
  }
  .plan--highlighted {
    border: 1px solid var(--teal);
    box-shadow: 0 0 0 4px var(--teal-tint);
  }
  .plan--soon {
    background: transparent;
    border-style: dashed;
  }
  .plan__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .plan__name {
    font-size: 18px;
    font-weight: 500;
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .plan__amount {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .plan--soon .plan__amount {
    color: var(--warm-mist);
  }
  .plan__note {
    font-size: 14px;
    color: var(--graphite);
  }
  .plan__cta {
    margin-top: auto;
    width: 100%;
  }
  .plan__cta--disabled {
    color: var(--ash);
    cursor: default;
    pointer-events: none;
  }
  .plan__placeholder {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 6px 0;
  }
  .plan__placeholder span {
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--hover) 0%, rgba(39, 37, 30, 0.1) 50%, var(--hover) 100%)
      0 0 / 200% 100%;
    animation: shimmer 2.4s ease-in-out infinite;
  }
  .plan__placeholder span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .plan__placeholder span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: -100% 0;
    }
  }
  .plan__placeholder span:nth-child(1) {
    width: 80%;
  }
  .plan__placeholder span:nth-child(2) {
    width: 64%;
  }
  .plan__placeholder span:nth-child(3) {
    width: 72%;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }
  .badge--accent {
    background: var(--teal);
    color: #fff;
  }
  .badge--muted {
    background: var(--hover);
    color: var(--graphite);
  }
  @media (max-width: 900px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* FAQ */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 64px);
    align-items: start;
  }
  .faq__list {
    display: flex;
    flex-direction: column;
  }
  .faq__item {
    border-bottom: 1px solid var(--hairline);
  }
  .faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 0;
    font-size: 17px;
    font-weight: 500;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item p {
    padding: 0 40px 22px 0;
  }
  .faq__plus {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--graphite);
    transition: transform 160ms var(--ease);
  }
  .faq__plus::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__plus::after {
    transform: rotate(0deg);
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* CTA */
  .cta-section {
    padding-top: clamp(56px, 8vw, 96px);
  }
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: clamp(40px, 7vw, 80px) 24px;
    border-radius: var(--r-2xl);
    background: var(--ink);
    color: var(--parchment);
    background-image: radial-gradient(rgba(250, 248, 245, 0.1) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .cta .lead {
    color: #cfcabf;
    max-width: 560px;
  }
  .btn--accent {
    background: var(--parchment);
    border-color: var(--parchment);
    color: var(--ink);
  }
  .btn--accent:hover {
    background: #fff;
  }
  .btn--ghost-light {
    border-color: rgba(250, 248, 245, 0.3);
    color: var(--parchment);
  }
  .btn--ghost-light:hover {
    background: rgba(250, 248, 245, 0.08);
  }
  /* ================================================================ RUCH */

  /* Pulsująca kropka przy eyebrow w hero */
  .eyebrow--live::before {
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 var(--teal-ring);
    }
    70%,
    100% {
      box-shadow: 0 0 0 7px rgba(1, 106, 113, 0);
    }
  }

  /* Okno aplikacji: pochylone na starcie, prostuje się przy przewijaniu */
  .hero__visual {
    perspective: 1600px;
  }
  .stage {
    --tilt: 1;
    position: relative;
